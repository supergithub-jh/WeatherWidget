<!DOCTYPE html> <html lang="en"> <head> <meta charset="utf-8" /> <meta name="viewport" content="width=device-width,initial-scale=1" /> <title>Weather Widget — 94401 San Mateo (Debug)</title> <style> :root{--bg1:#0b3b6f;--bg2:#1177cc;--card:#fff;--muted:rgba(255,255,255,0.85);--glass:rgba(255,255,255,0.06);} *{box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial;} body{margin:0;padding:0;background:linear-gradient(135deg,var(--bg1),var(--bg2));color:var(--card)} .widget{width:100%;max-width:520px;padding:14px;display:flex;gap:12px;align-items:center; background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border-radius:10px;box-shadow:0 6px 18px rgba(0,0,0,0.25);color:var(--card);} .left{display:flex;flex-direction:column;gap:6px;min-width:140px;} .loc{font-weight:600;font-size:1rem;color:var(--muted);} .temp{font-size:48px;line-height:1;font-weight:700;display:flex;align-items:baseline;gap:8px;} .temp .deg{font-size:22px;font-weight:600;opacity:.95} .conds{font-size:14px;color:var(--muted)} .right{flex:1;display:flex;flex-direction:column;gap:8px;} .current-row{display:flex;align-items:center;gap:12px} .icon{width:76px;height:76px;border-radius:12px;background:var(--glass);display:flex;align-items:center;justify-content:center;font-size:36px;filter:drop-shadow(0 6px 12px rgba(0,0,0,0.35));} .details{display:flex;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:13px} .detail{background:rgba(255,255,255,0.03);padding:6px 8px;border-radius:8px} .forecast{display:flex;gap:8px;align-items:center;overflow:auto;padding-top:4px} .day{min-width:72px;background:rgba(255,255,255,0.03);padding:8px;border-radius:8px;text-align:center;font-size:13px} .dtemp{font-weight:700;font-size:16px} .small{font-size:12px;color:var(--muted)} .attribution{font-size:11px;color:rgba(255,255,255,0.65);margin-top:8px} .error-details{font-size:12px;color:#ffdddd;background:rgba(255,0,0,0.12);padding:6px;border-radius:6px;margin-top:6px} @media (max-width:420px){ .temp{font-size:36px} .icon{width:60px;height:60px;font-size:28px} } </style> </head> <body> <div class="widget" id="weather-widget" role="region" aria-label="Local weather"> <div class="left"> <div class="loc" id="loc">Loading...</div> <div class="temp"><span id="temp">--</span><span class="deg">°F</span></div> <div class="conds" id="conds">—</div> </div> <div class="right"> <div class="current-row"> <div class="icon" id="icon">☀️</div> <div style="flex:1"> <div class="details" id="details"> <div class="detail" id="feels">Feels: --°</div> <div class="detail" id="wind">Wind: --</div> <div class="detail" id="hum">Humidity: --%</div> </div> </div> </div> <div class="forecast" id="forecast" aria-hidden="false"></div> <div class="attribution">Data: Open-Meteo · Geocoding skipped (coords used)</div> <div id="errorBox" class="error-details" style="display:none;"></div> </div> </div> <script> /**************************************************************** * CONFIG: Use coordinates for ZIP 94401 (San Mateo, CA) * This avoids geocoding requests which can be blocked in some embed contexts. ****************************************************************/ const UNITS = "imperial"; // 'imperial' => °F/mph const LAT = 37.5626; const LON = -122.3255; const NICE_NAME = "San Mateo, CA 94401"; const weatherCodeMap = { 0:{icon:"☀️",text:"Clear"},1:{icon:"🌤️",text:"Mainly clear"},2:{icon:"⛅",text:"Partly cloudy"}, 3:{icon:"☁️",text:"Overcast"},45:{icon:"🌫️",text:"Fog"},48:{icon:"🌫️",text:"Rime fog"}, 51:{icon:"🌦️",text:"Light drizzle"},53:{icon:"🌦️",text:"Moderate drizzle"},55:{icon:"🌧️",text:"Dense drizzle"}, 56:{icon:"🌧️",text:"Freezing drizzle"},57:{icon:"🌧️",text:"Dense freezing drizzle"},61:{icon:"🌧️",text:"Slight rain"}, 63:{icon:"🌧️",text:"Moderate rain"},65:{icon:"🌧️",text:"Heavy rain"},66:{icon:"🌧️",text:"Freezing rain"}, 67:{icon:"🌧️",text:"Heavy freezing rain"},71:{icon:"❄️",text:"Slight snow"},73:{icon:"❄️",text:"Moderate snow"}, 75:{icon:"❄️",text:"Heavy snow"},77:{icon:"🌨️",text:"Snow grains"},80:{icon:"🌦️",text:"Rain showers"}, 81:{icon:"🌧️",text:"Moderate showers"},82:{icon:"⛈️",text:"Violent showers"},85:{icon:"❄️",text:"Snow showers"}, 86:{icon:"❄️",text:"Heavy snow showers"},95:{icon:"⛈️",text:"Thunderstorm"},96:{icon:"⛈️",text:"Thunderstorm with hail"}, 99:{icon:"⛈️",text:"Severe thunderstorm with hail"} }; function setText(id, txt){ const el=document.getElementById(id); if(el) el.textContent=txt; } function setHTML(id, html){ const el=document.getElementById(id); if(el) el.innerHTML=html; } function showError(msg){ const eb = document.getElementById('errorBox'); eb.style.display = 'block'; eb.textContent = msg; } async function fetchWeather(lat, lon){ const tempUnit = (UNITS === "imperial") ? "fahrenheit" : "celsius"; const windUnit = (UNITS === "imperial") ? "mph" : "kmh"; const dailyParams = "temperature_2m_max,temperature_2m_min,weathercode"; const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=${dailyParams}&timezone=auto&temperature_unit=${tempUnit}&windspeed_unit=${windUnit}`; const res = await fetch(url); if(!res.ok){ // Attempt to surface response body for debugging let body = ''; try { body = await res.text(); } catch(e) { body = '<unable to read body>'; } throw new Error(`Weather API error: ${res.status} ${res.statusText} — ${body}`); } return await res.json(); } function buildForecastHTML(daily){ if(!daily || !daily.time) return '<div class="small">No forecast</div>'; const days = daily.time.map((t,i)=>{ const date = new Date(t); const weekday = date.toLocaleDateString(undefined, {weekday:"short"}); const code = daily.weathercode[i]; const max = Math.round(daily.temperature_2m_max[i]); const min = Math.round(daily.temperature_2m_min[i]); const map = weatherCodeMap[code] || {icon:"❔", text:"Unknown"}; return {weekday, icon: map.icon, text: map.text, max, min}; }); let html = ""; // Show next 3 days (skip index 0 = today) for(let i=1;i<Math.min(days.length,4);i++){ const d = days[i]; html += `<div class="day" title="${d.text}"><div class="small">${d.weekday}</div><div style="font-size:20px;margin:6px 0">${d.icon}</div><div class="dtemp">${d.max}°</div><div class="small" style="opacity:.85">${d.min}°</div></div>`; } return html; } async function render(){ try{ // set initial UI setText('loc', NICE_NAME); setText('conds', 'Loading weather...'); setText('temp', '--'); setHTML('icon','⏳'); const w = await fetchWeather(LAT, LON); if(!w) throw new Error('Empty weather response'); const cw = w.current_weather; const daily = w.daily; if(!cw){ throw new Error('current_weather missing in API response'); } setText('temp', Math.round(cw.temperature)); const wc = weatherCodeMap[cw.weathercode] || {icon:"❔", text:"Unknown"}; setText('conds', wc.text + (cw.winddirection ? ` · ${cw.winddirection}°` : "")); setHTML('icon', wc.icon); setText('feels', `Temperature: ${Math.round(cw.temperature)}°`); setText('wind', `Wind: ${Math.round(cw.windspeed)} ${UNITS==="imperial"?"mph":"km/h"}`); setText('hum', 'Humidity: —'); setHTML('forecast', buildForecastHTML(daily)); // hide error box if present document.getElementById('errorBox').style.display = 'none'; } catch(err){ console.error('Weather widget error:', err); setText('conds', 'Unable to load weather'); setText('temp', '—'); setHTML('icon', '❌'); showError(String(err.message || err)); } } // Run once and periodically render(); setInterval(render, 10*60*1000); </script> </body> </html>
